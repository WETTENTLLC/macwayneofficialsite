                            <label for="volunteer-email">Your Email:</label>
                            <input type="email" id="volunteer-email" required>
                            <label for="volunteer-phone">Phone Number (Optional):</label>
                            <input type="tel" id="volunteer-phone">
                            <label for="volunteer-availability">Availability/Preferences:</label>
                            <textarea id="volunteer-availability" rows="4" placeholder="Tell us about your availability, skills, or what kind of volunteering you're interested in."></textarea>
                            <button type="submit" id="volunteer-submit-button">Sign Up to Volunteer</button>
                            <div id="volunteer-message"></div>
                            <div id="volunteer-error"></div>
                        </form>
                    </section>
