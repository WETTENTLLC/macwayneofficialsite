        <!-- Help The Blind Man Section - Key Interactive Feature -->
        <section class="strange-section help-blind-man-section" id="help-blind-man" aria-labelledby="help-blind-man-heading">
            <div class="help-container">
                <h2 class="strange-header">HELP THE BLIND MAN</h2>
                <div class="help-content">
                    <div class="story-section">
                        <div class="blind-story">
                            <h3 class="story-title">MAC WAYNE'S JOURNEY</h3>
                            <p class="story-text">
                                Mac Wayne lost his sight but never lost his vision. After going blind, he discovered his true calling in music, 
                                using his other senses to create powerful lyrics and vocal delivery that touch the soul. His blindness isn't a limitation - 
                                it's his superpower.
                            </p>
                            <div class="story-audio">
                                <a href="documentary.html" class="story-play-btn">
                                    <i class="fas fa-play"></i>
                                    HEAR HIS STORY
                                </a>
                                <!-- <audio id="going-blind-audio" preload="metadata">
                                    <source src="public/audio/going-blind-story.mp3" type="audio/mpeg">
                                </audio> -->
                            </div>
                        </div>
                    </div>
                    
                    <div class="interaction-section">
                        <h3 class="interaction-title">GUIDE MAC WAYNE</h3>
                        <p class="interaction-description">
                            Experience what it's like to navigate the world without sight. Help guide Mac Wayne through different scenarios 
                            and understand his daily challenges.
                        </p>
                        
                        <div class="interaction-game">
                            <div class="game-screen" id="guidance-game">
                                <div class="scene active" data-scene="studio">
                                    <h4>STUDIO SESSION</h4>
                                    <p>Mac Wayne needs to find his way to the recording booth. Help guide him:</p>
                                    <div class="direction-buttons">
                                        <button class="direction-btn" data-direction="left" data-correct="false">
                                            <i class="fas fa-arrow-left"></i> LEFT
                                        </button>
                                        <button class="direction-btn" data-direction="forward" data-correct="true">
                                            <i class="fas fa-arrow-up"></i> STRAIGHT
                                        </button>
                                        <button class="direction-btn" data-direction="right" data-correct="false">
                                            <i class="fas fa-arrow-right"></i> RIGHT
                                        </button>
                                    </div>
                                    <div class="feedback" id="scene-feedback"></div>
                                </div>
                                
                                <div class="scene" data-scene="stage">
                                    <h4>ON STAGE</h4>
                                    <p>Mac Wayne is performing. Help him locate the microphone:</p>
                                    <div class="direction-buttons">
                                        <button class="direction-btn" data-direction="left" data-correct="true">
                                            <i class="fas fa-arrow-left"></i> LEFT
                                        </button>
                                        <button class="direction-btn" data-direction="forward" data-correct="false">
                                            <i class="fas fa-arrow-up"></i> STRAIGHT
                                        </button>
                                        <button class="direction-btn" data-direction="right" data-correct="false">
                                            <i class="fas fa-arrow-right"></i> RIGHT
                                        </button>
                                    </div>
                                    <div class="feedback" id="scene-feedback-stage"></div>
                                </div>
                            </div>
                        </div>
                    </div>                    
                    <!-- Community Support Features Start -->
                    <section id="donate-section">
                        <h2>Make a Donation</h2>
                        <p>Your contribution helps us provide vital support to the visually impaired.</p>
                        <form id="donation-form">
                            <label for="donation-amount">Donation Amount:</label>
                            <select id="donation-amount" name="amount">
                                <option value="10">USD $10</option>
                                <option value="25">USD $25</option>
                                <option value="50">USD $50</option>
                                <option value="100">USD $100</option>
                                <option value="custom">Custom Amount</option>
                            </select>
                            <input type="number" id="custom-amount" placeholder="Enter custom amount" style="display: none;">
                            <label for="donation-type">Donation Type:</label>
                            <select id="donation-type" name="type">
                                <option value="one-time">One-Time</option>
                                <option value="recurring">Monthly Recurring</option>
                            </select>
                            <div id="payment-element"></div>
                            <button type="submit" id="donate-button">Donate Now</button>
                            <div id="donation-message"></div>
                            <div id="donation-error"></div>
                        </form>
                    </section>
                    <section id="volunteer-section">
                        <h2>Become a Volunteer</h2>
                        <p>Your time and effort can make a significant difference. Sign up to volunteer!</p>
                        <form id="volunteer-form">
