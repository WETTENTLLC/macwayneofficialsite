        <!-- Music Section -->
        <section id="music" class="strange-section music-section">
            <div class="container">
                <div class="album-relaunch-announcement">
                    <h2>THE LEGEND RETURNS: "Blind and Battered" - The Re-Release</h2>
                    <p class="story-intro">Originally unleashed in 2010, Mac Wayne's iconic album "Blind and Battered" is back. After a long hiatus, Mac Wayne is out and ready to reclaim his throne. This re-release isn't just music; it's a testament to resilience, a story of a comeback, and a fresh chance to experience the raw energy that defines Mac Wayne. Every track tells a story, every verse hits harder. This is more than an album – it's a statement.</p>
                    <p class="album-details"><strong>Album:</strong> Blind and Battered (Re-Release)<br>
                    <strong>Artist:</strong> Mac Wayne<br>
                    <strong>Original Release:</strong> 2010</p>
                </div>
        
                <!-- New Audio Player -->
                <div id="macwayne-player" class="macwayne-player-v2">
                    <audio id="audio-element" preload="metadata"></audio>
                    
                    <div class="player-main-display">
                        <img id="album-art" src="public/Images/macwayne-background.png" alt="Album Art for Blind and Battered" class="player-album-art">
                        <div class="player-track-info">
                            <h3 id="track-title">Select a track</h3>
                            <p id="track-artist">Mac Wayne</p>
                        </div>
                    </div>

                    <div class="player-progress-section">
                        <input type="range" id="progress-bar" class="player-progress-bar" value="0" min="0" max="100" step="0.1" aria-label="Track Progress">
                        <div class="player-time-display">
                            <span id="current-time">0:00</span>
                            <span id="duration">0:00</span>
                        </div>
                    </div>

                    <div class="player-controls">
                        <button id="prev-button" class="player-control-btn" aria-label="Previous Track"><i class="fas fa-step-backward"></i></button>
                        <button id="play-pause-button" class="player-control-btn play-pause-btn" aria-label="Play Track"><i class="fas fa-play"></i></button>
                        <button id="next-button" class="player-control-btn" aria-label="Next Track"><i class="fas fa-step-forward"></i></button>
                        <input type="range" id="volume-control" class="player-volume-slider" value="100" min="0" max="100" step="1" aria-label="Volume Control">
                    </div>

                    <div class="player-purchase-options">
                        <button id="stream-album-btn" class="purchase-btn stream"><i class="fas fa-stream"></i> Stream Full Album ($5.00)</button>
                        <button id="download-album-btn" class="purchase-btn download"><i class="fas fa-download"></i> Download Full Album ($15.00)</button>
                    </div>

                    <ul id="playlist" class="player-playlist">
                        <!-- Track items will be dynamically inserted here by JavaScript -->
                    </ul>
                </div>
            </div>
        </section>

          <!-- Upcoming Shows -->
        <section id="tour" class="strange-section shows-section">
            <h2 class="strange-header">UPCOMING SHOWS</h2>
            
            <!-- Coming Soon Message -->
            <div class="coming-soon-container">
                <div class="coming-soon-announcement">
                    <i class="fas fa-calendar-alt coming-soon-icon"></i>
                    <h3 class="coming-soon-title">COMING SOON</h3>
                    <p class="coming-soon-description">
                        Mac Wayne is planning his comeback tour! Live performances and exclusive streaming shows are in the works. 
                        Be the first to know when tickets go on sale.
                    </p>
                </div>
                
                <!-- Show Notification Signup -->
                <div class="show-notifications-signup">
                    <h4 class="signup-title">GET NOTIFIED ABOUT SHOWS</h4>
                    <p class="signup-description">
                        Sign up to receive exclusive notifications about upcoming live performances, virtual concerts, and streaming events.
                    </p>
                    
                    <form class="show-signup-form" id="show-notifications-form">
                        <div class="signup-form-grid">
                            <div class="form-group">
                                <input type="text" placeholder="Your Name" class="strange-input" name="name" required />
                            </div>
                            <div class="form-group">
                                <input type="email" placeholder="Your Email" class="strange-input" name="email" required />
                            </div>
                            <div class="form-group">
                                <select class="strange-input" name="showType" required>
                                    <option value="">Show Type Preference</option>
                                    <option value="live">Live Performances</option>
                                    <option value="streaming">Live Streaming</option>
                                    <option value="both">Both Live & Streaming</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <input type="text" placeholder="City (Optional)" class="strange-input" name="city" />
                            </div>
                        </div>
                        
                        <div class="notification-preferences">
                            <label class="checkbox-label">
                                <input type="checkbox" name="earlyAccess" value="yes">
                                <span class="checkmark"></span>
                                Early access to tickets
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" name="backstageUpdates" value="yes">
                                <span class="checkmark"></span>
                                Behind-the-scenes updates
                            </label>
                            <label class="checkbox-label">
                                <input type="checkbox" name="streamingAlerts" value="yes" checked>
                                <span class="checkmark"></span>
                                Live streaming notifications
                            </label>
                        </div>
                        
                        <button type="submit" class="strange-button notification-signup-btn">
                            <i class="fas fa-bell"></i> NOTIFY ME ABOUT SHOWS
                        </button>
                    </form>
                    
                    <div class="signup-success-message" id="show-signup-success" style="display: none;">
                        <i class="fas fa-check-circle"></i>
                        <p>You're all set! We'll notify you as soon as Mac Wayne announces upcoming shows.</p>
                    </div>
                </div>
            </div>
        </section>
        
        <!-- Newsletter -->
        <section id="contact" class="strange-section newsletter-section">
            <h2 class="strange-header">JOIN THE FANBASE</h2>
            <div class="newsletter-form">
                <p class="newsletter-description">Subscribe to get updates on new music, videos, tour dates, and exclusive content.</p>
                <form class="newsletter-form-grid" id="newsletter-form">
                    <div class="form-group">
                        <input type="text" placeholder="Your Name" class="strange-input" name="name" required />
                    </div>
                    <div class="form-group">
                        <input type="email" placeholder="Your Email" class="strange-input" name="email" required />
                    </div>
                    <div class="form-submit">
                        <button type="submit" class="strange-button">SUBSCRIBE</button>
                    </div>
                </form>
            </div>
        </section>
        
        <!-- Encouragement Modal -->
        <div id="encouragement-modal" class="modal" style="display: none;">
            <div class="modal-content">
                <div class="modal-header">
                    <h3>Send Encouragement to Mac Wayne</h3>
                    <span class="close-modal" onclick="closeEncouragementModal()">&times;</span>
                </div>
                <div class="modal-body">
                    <p>Your words of encouragement mean everything to Mac Wayne. Share your thoughts, support, or just let him know you're listening!</p>
                    <form id="encouragement-form">
                        <div class="form-group">
                            <label for="encourager-name">Your Name (optional):</label>
                            <input type="text" id="encourager-name" class="strange-input" placeholder="Anonymous supporter">
                        </div>
                        <div class="form-group">
                            <label for="encouragement-message">Your Message:</label>
                            <textarea id="encouragement-message" class="strange-input" rows="4" placeholder="Write your encouraging message here..." required></textarea>
                        </div>
                        <div class="form-group">
                            <label>
                                <input type="checkbox" id="share-publicly" style="margin-right: 0.5rem;">
                                Allow this message to be shared publicly on the website
                            </label>
                        </div>
                        <button type="submit" class="strange-button">SEND ENCOURAGEMENT</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Development Note -->
    <div class="dev-note" style="margin-top: 1rem; padding: 1rem; background: rgba(100, 100, 100, 0.2); border-radius: 8px; font-size: 0.875rem; color: #888;">
            <strong>Development Note:</strong> All tracks are in 30-second preview mode. 
            Open browser console and type <code>unlockTracks()</code> to test full playback.
            Type <code>testPreviewMode()</code> to check preview status.
        </div>
    </div>    
    
    <!-- PayPal SDK (for payment buttons) -->
    <script src="https://www.paypal.com/sdk/js?client-id=AXJxMSZ5Ab8qMfPIwXlRSsuDGOYzUzl-WELr5qI6h_2-R8TzlUCIqR-xAppjTv-WxVCPGDocJXM_YJ5M&currency=USD&intent=capture&disable-funding=card"></script>
    <!-- JavaScript Files -->
    <script src="js/main.js"></script>
    <script src="js/macwayne-player.js" defer></script>
    <script src="js/animations.js"></script>
    <script src="js/help-blind-man.js"></script>
    <!-- Firebase -->
    <script src="https://www.gstatic.com/firebasejs/9.0.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.0.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.0.0/firebase-firestore-compat.js"></script>
    <script>
    // --- Firebase Initialization ---
    // IMPORTANT: Replace these placeholder values with your actual Firebase project configuration.
    // You can find these in your Firebase project settings.
    const firebaseConfig = {
        apiKey: "AIzaSyArzPAcNlT1RJzIx7zCk4PbbHn71OAOQL8",
        authDomain: "mac-wayne-site.firebaseapp.com",
        projectId: "mac-wayne-site",
        storageBucket: "mac-wayne-site.appspot.com",
        messagingSenderId: "1042802261560",
        appId: "1:1042802261560:web:0adf8bde78a5292f86f0cd"
    };
    const app = firebase.initializeApp(firebaseConfig);
    const db = firebase.firestore();
    const auth = firebase.auth();
    // --- Real-Time Assistance Logic (Conceptual, see comments for production needs) ---
    document.addEventListener('DOMContentLoaded', () => {
        // --- Mac Wayne's Side ---
        const requestHelpButton = document.getElementById('request-help-button');
        const macwayneStatus = document.getElementById('macwayne-status');
        const remoteAudio = document.getElementById('remote-audio');
        let peerConnection, localStream, currentCallDocRef;
        const servers = { iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] };
        async function createPeerConnection() {
            peerConnection = new RTCPeerConnection(servers);
            peerConnection.onicecandidate = async (event) => {
                if (event.candidate && currentCallDocRef) {
                    await currentCallDocRef.collection('iceCandidates').add({
                        candidate: event.candidate.toJSON(),
                        type: 'local'
                    });
                }
            };
            peerConnection.ontrack = (event) => {
                if (remoteAudio) remoteAudio.srcObject = event.streams[0];
            };
        }
        function listenForIceCandidates(callDocRef) {
            callDocRef.collection('iceCandidates').onSnapshot(snapshot => {
                snapshot.docChanges().forEach(async change => {
                    if (change.type === 'added') {
                        const candidate = new RTCIceCandidate(change.doc.data().candidate);
                        if (peerConnection) await peerConnection.addIceCandidate(candidate);
                    }
                });
            });
        }
        if (requestHelpButton) {
            requestHelpButton.addEventListener('click', async () => {
                macwayneStatus.textContent = 'Status: Requesting help...';
                try {
                    currentCallDocRef = await db.collection('calls').add({
                        callerId: auth.currentUser ? auth.currentUser.uid : 'MacWayne123',
                        status: 'ringing',
                        timestamp: firebase.firestore.FieldValue.serverTimestamp()
                    });
                    currentCallDocRef.onSnapshot(async (snapshot) => {
                        const data = snapshot.data();
                        if (data && data.answer && !peerConnection) {
                            macwayneStatus.textContent = 'Status: Connecting...';
                            await createPeerConnection();
                            await peerConnection.setRemoteDescription(new RTCSessionDescription(data.answer));
                            listenForIceCandidates(currentCallDocRef);
                        } else if (data && data.status === 'ended') {
                            macwayneStatus.textContent = 'Status: Call ended by volunteer.';
                            if (peerConnection) peerConnection.close();
                            peerConnection = null;
                            if (remoteAudio) remoteAudio.srcObject = null;
                        }
                    });
                    listenForIceCandidates(currentCallDocRef);
                } catch (error) {
                    macwayneStatus.textContent = 'Status: Error requesting help.';
                }
            });
        }
        // --- Volunteer Dashboard ---
        const assistanceRequestsDiv = document.getElementById('assistance-requests');
        const activeCallPanel = document.getElementById('active-call-panel');
        const connectedUserIdSpan = document.getElementById('connected-user-id');
        const endCallButton = document.getElementById('end-call-button');
        const volunteerEmailInput = document.getElementById('volunteer-email');
        const volunteerPasswordInput = document.getElementById('volunteer-password');
        const volunteerLoginButton = document.getElementById('volunteer-login-button');
        const volunteerLogoutButton = document.getElementById('volunteer-logout-button');
        const authStatus = document.getElementById('auth-status');
        let unsubscribeRequests;
        if (volunteerLoginButton) {
            volunteerLoginButton.addEventListener('click', async () => {
                const email = volunteerEmailInput.value;
                const password = volunteerPasswordInput.value;
                try {
                    await auth.signInWithEmailAndPassword(email, password);
                    authStatus.textContent = 'Logged in as Volunteer!';
                    volunteerLoginButton.style.display = 'none';
                    volunteerLogoutButton.style.display = 'inline';
                    listenForHelpRequests();
                } catch (error) {
                    authStatus.textContent = `Login failed: ${error.message}`;
                }
            });
            volunteerLogoutButton.addEventListener('click', async () => {
                await auth.signOut();
                authStatus.textContent = 'Logged out.';
                volunteerLoginButton.style.display = 'inline';
                volunteerLogoutButton.style.display = 'none';
                if (unsubscribeRequests) unsubscribeRequests();
            });
            auth.onAuthStateChanged(user => {
                if (user) {
                    authStatus.textContent = `Logged in as ${user.email}`;
                    volunteerLoginButton.style.display = 'none';
                    volunteerLogoutButton.style.display = 'inline';
                    listenForHelpRequests();
                } else {
                    authStatus.textContent = 'Please log in as a volunteer.';
                    volunteerLoginButton.style.display = 'inline';
                    volunteerLogoutButton.style.display = 'none';
                }
            });
        }
        function listenForHelpRequests() {
            if (!auth.currentUser) return;
            if (unsubscribeRequests) unsubscribeRequests();
            unsubscribeRequests = db.collection('calls')
                .where('status', '==', 'ringing')
                .orderBy('timestamp', 'asc')
                .onSnapshot((snapshot) => {
                    assistanceRequestsDiv.innerHTML = '';
                    if (snapshot.empty) {
                        assistanceRequestsDiv.innerHTML = '<p>No active requests.</p>';
                        return;
                    }
                    snapshot.forEach(doc => {
                        const request = doc.data();
                        const requestId = doc.id;
                        const requestItem = document.createElement('div');
                        requestItem.innerHTML = `<p>Help request from ${request.callerId}</p>`;
                        const acceptButton = document.createElement('button');
                        acceptButton.textContent = 'Accept Call';
                        acceptButton.addEventListener('click', async () => {
                            if (peerConnection) {
                                alert('Already in a call. Please end current call first.');
                                return;
                            }
                            activeCallPanel.style.display = 'block';
                            connectedUserIdSpan.textContent = request.callerId;
                            assistanceRequestsDiv.innerHTML = '';
                            await doc.ref.update({ status: 'accepted', volunteerId: auth.currentUser.uid });
                            doc.ref.onSnapshot(async (snapshotData) => {
                                const data = snapshotData.data();
                                if (data && data.offer && !peerConnection) {
                                    await createPeerConnection();
                                    await peerConnection.setRemoteDescription(new RTCSessionDescription(data.offer));
                                    const answer = await peerConnection.createAnswer();
                                    await peerConnection.setLocalDescription(answer);
                                    await doc.ref.update({ answer: { type: answer.type, sdp: answer.sdp } });
                                    listenForIceCandidates(doc.ref);
                                } else if (data && data.status === 'ended') {
                                    alert('Call ended by Mac Wayne.');
                                    if (peerConnection) peerConnection.close();
                                    peerConnection = null;
                                }
                            });
                            listenForIceCandidates(doc.ref);
                        });
                        requestItem.appendChild(acceptButton);
                        assistanceRequestsDiv.appendChild(requestItem);
                    });
                });
        }
        if (endCallButton) {
            endCallButton.addEventListener('click', async () => {
                if (currentCallDocRef) {
                    await currentCallDocRef.update({ status: 'ended' });
                    if (peerConnection) peerConnection.close();
                    peerConnection = null;
                    if (remoteAudio) remoteAudio.srcObject = null;
                    if (activeCallPanel) activeCallPanel.style.display = 'none';
                }
            });
        }
        // --- Text-to-Speech for Prompts ---
        const voicePromptInput = document.getElementById('voice-prompt-input');
        const sendVoicePromptButton = document.getElementById('send-voice-prompt-button');
        if (sendVoicePromptButton) {
            sendVoicePromptButton.addEventListener('click', async () => {
                const text = voicePromptInput.value;
                if (text && currentCallDocRef) {
                    await currentCallDocRef.collection('prompts').add({
                        text: text,
                        timestamp: firebase.firestore.FieldValue.serverTimestamp()
                    });
                    voicePromptInput.value = '';
                }
            });
        }
        // --- Mac Wayne's Side: Listen for Prompts and Speak ---
        if (macwayneStatus) {
            db.collection('calls').where('callerId', '==', auth.currentUser ? auth.currentUser.uid : 'MacWayne123')
                .onSnapshot(querySnapshot => {
                    querySnapshot.forEach(doc => {
                        doc.ref.collection('prompts').orderBy('timestamp', 'desc').limit(1).onSnapshot(promptSnapshot => {
                            promptSnapshot.forEach(promptDoc => {
                                const prompt = promptDoc.data();
                                if ('speechSynthesis' in window) {
                                    const utterance = new SpeechSynthesisUtterance(prompt.text);
                                    utterance.lang = 'en-US';
                                    window.speechSynthesis.speak(utterance);
                                }
                            });
                        });
                    });
                });
        }
    });
    </script>
    <!-- LIVE INTERACTIVE ASSISTANCE: Help the Blind Man -->
            <section id="macwayne-help-section" class="strange-section">
                <h2 class="strange-header">Mac Wayne's Live Assistance Panel</h2>
                <p>Press the button below to request live voice assistance from a volunteer.</p>
                <button id="request-help-button">Request Live Help</button>
                <p id="macwayne-status">Status: Idle</p>
                <audio id="remote-audio" autoplay></audio>
            </section>
            <!-- Volunteer Dashboard (for authenticated helpers) -->
            <section id="volunteer-dashboard-section" class="strange-section">
                <h2 class="strange-header">Volunteer Dashboard</h2>
                <p>Live assistance requests:</p>
                <div id="assistance-requests">
                    <p>No active requests.</p>
                </div>
                <div id="active-call-panel" style="display: none;">
                    <h3>Active Call</h3>
                    <p>Connected to: <span id="connected-user-id"></span></p>
                    <input type="text" id="voice-prompt-input" placeholder="Type prompt here for Mac Wayne">
                    <button id="send-voice-prompt-button">Send Voice Prompt (TTS)</button>
                    <button id="start-voice-stream-button">Start Live Voice Stream</button>
                    <button id="end-call-button">End Call</button>
                    <p>Mac Wayne says: <span id="macwayne-transcription"></span></p>
                </div>
                <div>
                    <h3>Volunteer Login</h3>
                    <input type="email" id="volunteer-email-login" placeholder="Email">
                    <input type="password" id="volunteer-password" placeholder="Password">
                    <button id="volunteer-login-button">Login</button>
                    <button id="volunteer-logout-button" style="display:none;">Logout</button>
                    <p id="auth-status"></p>
                </div>
            </section>
