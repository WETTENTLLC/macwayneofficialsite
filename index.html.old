<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mac Wayne Official - Blind Hip Hop Visionary | Accessibility Innovation Through Music</title>
    <meta name="description" content="Experience Mac Wayne's revolutionary accessibility-focused music platform. Blind hip-hop artist showcasing innovative audio technology, accessible design, and assistive music experiences. Perfect for accessibility tech partnerships and inclusive digital innovation.">
    
    <!-- Advanced SEO for Accessibility Tech Companies -->
    <meta name="keywords" content="blind rapper, accessibility technology, assistive technology, accessible music platform, inclusive design, disability tech innovation, accessible audio player, screen reader compatible, visually impaired artist, accessibility partnerships, inclusive technology, assistive music technology, digital accessibility, WCAG compliance, inclusive entertainment, accessibility consulting, disabled artists, accessible web design, audio accessibility, inclusive user experience">
    
    <!-- Accessibility & Tech Company Targeting -->
    <meta name="subject" content="Accessibility Innovation in Music Technology">
    <meta name="audience" content="Accessibility Technology Companies, Assistive Technology Developers, Inclusive Design Teams">
    <meta name="target-companies" content="MetaView, Aris Technologies, Google Accessibility, Microsoft Accessibility, Apple Accessibility, NVDA, JAWS, Voice Dream, Be My Eyes, Aira">
    
    <!-- All your existing meta tags and CSS -->
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="styles/audio-player.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
